{
  "name": "personal-finance-tracker-root",
  "version": "1.0.0",
  "description": "Full-Stack Personal Finance Tracker with Charts, JWT Auth, and Budgeting",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,emerald\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "build": "npm --prefix client run build"
  },
  "keywords": ["finance", "react", "express", "mongodb", "recharts", "tailwind", "jwt"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
